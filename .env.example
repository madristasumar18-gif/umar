# Environment variables for KHALS Safety Solutions
# Copy this file to .env.local and fill in your values

# Email Configuration (for enquiry notifications)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-app-password

# KHALS Contact Email (where enquiries will be sent)
KHALS_EMAIL=khalssafety@gmail.com

# Optional: Twilio for SMS notifications
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE=+1234567890

# Optional: Database (for storing enquiries)
# DATABASE_URL=your-database-connection-string
